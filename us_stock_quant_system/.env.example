# ============================================================
# US Stock Quant System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Trading Mode ---
# DRY_RUN=true: simulate orders, no real money
# PAPER_TRADING=true: use broker paper trading API
# LIVE_TRADING=true: REAL MONEY - REQUIRES ADDITIONAL CONFIRMATION
DRY_RUN=true
PAPER_TRADING=false
LIVE_TRADING=false

# This MUST be set to "I_UNDERSTAND_THE_RISK" to enable LIVE_TRADING
CONFIRM_LIVE_TRADING=

# --- Alpaca Markets (paper or live) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Interactive Brokers (paper or live) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=

# --- Data ---
# Custom data source (optional, defaults to yfinance)
# DATA_PROVIDER=yahoo
# POLYGON_API_KEY=
# TIINGO_API_KEY=

# --- General ---
LOG_LEVEL=INFO
